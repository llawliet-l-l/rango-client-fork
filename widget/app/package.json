{
  "name": "@arthur2079/widget-app",
  "version": "1.4.0",
  "license": "MIT",
  "private": true,
  "source": "public/index.html",
  "main": "dist/index.html",
  "targets": {
    "main": false
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "dev": "parcel -p 3002 --cache-dir=.parcel-cache --no-cache",
    "build": "parcel build --cache-dir=.parcel-cache",
    "ts-check": "tsc --declaration --emitDeclarationOnly -p ./tsconfig.json",
    "clean": "rimraf .parcel-cache && rimraf dist",
    "format": "prettier --write '{.,src}/**/*.{ts,tsx}'",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "parcel": "^2.16.4",
    "vm-browserify": "^1.1.2"
  },
  "dependencies": {
    "@arthur2079/logging-console": "^1.1.0",
    "@arthur2079/logging-subscriber": "^1.1.0",
    "@arthur2079/widget-embedded": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  }
}
