    "rango-types": "*",
    "uuid": "*"
  },
  "devDependencies": {
    "@types/uuid": "^8.3.4"
  },
  "dependencies": {
    "@arthur2079/logging-core": "^1.1.0",
    "@hub3js/core": "^0.61.1",
    "@hub3js/namespaces": "^0.2.5",
    "@hub3js/stellar": "^0.2.3",
    "@hub3js/xrpl": "^0.2.3",
    "@stellar/stellar-sdk": "^15.0.1",
    "rango-types": "^0.5.0",
