{
  "name": "@arthur2079/provider-keplr",
  "version": "0.61.0",
  "repository": {
    "url": "https://github.com/llawliet-l-l/rango-client-fork.git"
  },
  "license": "MIT",
  "type": "module",
  "source": "./src/mod.ts",
  "main": "./dist/mod.js",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "typings": "dist/mod.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build/command.mjs --path wallets/provider-keplr --inputs src/mod.ts,src/lib.ts",
    "ts-check": "tsc --declaration --emitDeclarationOnly -p ./tsconfig.json",
    "clean": "rimraf dist",
    "format": "prettier --write '{.,src}/**/*.{ts,tsx}'",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@arthur2079/signer-cosmos": "^0.41.0",
    "@arthur2079/wallets-core": "^0.60.0",
    "@arthur2079/wallets-shared": "^0.61.0",
    "@chain-registry/keplr": "^2.0.198",
    "rango-types": "^0.5.0"
  },
  "devDependencies": {
    "@keplr-wallet/types": "^0.13.26",
    "starknet": "^8"
  },
  "resolutions": {
    "@keplr-wallet/types/secretjs/protobufjs": "^6.11.4"
  },
  "publishConfig": {
    "access": "public"
  }
}